{
  "release_version": "0.10.8",
  "summary": "Release-gated command claims for the 0.10.8 CLI (start / doctor / runs show).",
  "allowed_claims": [
    "python3.12 -m venv .venv",
    ". .venv/bin/activate",
    "pip install xrtm==0.10.8",
    "export OPENAI_API_KEY=sk-...",
    "export OPENAI_BASE_URL=https://api.deepseek.com",
    "export OPENAI_MODEL=deepseek-v4-flash",
    "xrtm --version",
    "xrtm doctor",
    "xrtm start",
    "xrtm start --limit 2",
    "xrtm start --limit 10",
    "xrtm start --runs-dir runs",
    "xrtm start --model deepseek-v4-pro --base-url https://api.deepseek.com",
    "xrtm start --provider mock --limit 2",
    "xrtm runs show --latest",
    "xrtm runs show --latest --runs-dir runs",
    "xrtm runs show <run-id> --runs-dir runs"
  ],
  "scopes": {
    "xrtm": {
      "files": [
        "README.md",
        "docs/getting-started.md",
        "docs/operator-runbook.md",
        "docs/python-api-reference.md"
      ]
    },
    "xrtm.org": {
      "files": [
        "docs/getting-started.md",
        "docs/examples.md",
        "docs/framework/intro.md",
        "docs/index.mdx",
        "docs/workflows/operator-runbook.md",
        "docs/workflows/researcher-model-eval.md",
        "src/pages/index.tsx"
      ]
    }
  },
  "runtime_validation": {
    "xrtm": {
      "baseline_mode": "deterministic",
      "first_class_categories": [
        "openai-compatible-endpoint",
        "coding-agent-cli-contract"
      ],
      "openai_compatible_profiles": {
        "local": [
          "local-llm"
        ],
        "commercial": [
          "openai"
        ]
      },
      "coding_agent_cli_profiles": [],
      "cloud_api_support_claimed": false
    }
  }
}
